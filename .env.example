# Copy this file to `.env` to enable the live sync with CouchDB (see docker-compose.yml).
# Leave QCLI_COUCHDB_URL empty to keep the data in the browser only.
#
# WARNING: QCLI_* variables are embedded in the client bundle.
# Never put production credentials here.
QCLI_COUCHDB_URL=http://localhost:5984/todos
QCLI_COUCHDB_USER=admin
QCLI_COUCHDB_PASSWORD=admin
