{
  "name": "quasar-todolist-pouchdb",
  "version": "1.0.0",
  "description": "Offline-first todo list built with Quasar, Vue 3, TypeScript and PouchDB (optional CouchDB sync)",
  "productName": "Todo PouchDB",
  "author": "Nicolas",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "lint": "prettier --write \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore && eslint --fix -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\" \"./scripts/**/*.ts\"",
    "lint:check": "prettier --check \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore && eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\" \"./scripts/**/*.ts\"",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "node scripts/screenshots.ts",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "events": "^3.3.0",
    "pinia": "^4.1.0",
    "pouchdb-browser": "^9.0.0",
    "pouchdb-find": "^9.0.0",
    "quasar": "^2.35.2",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.4.0"
  },
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@quasar/app-vite": "^3.10.3",
    "@types/node": "^22.20.5",
    "@types/pouchdb-browser": "^6.1.5",
    "@types/pouchdb-core": "^7.0.15",
    "@types/pouchdb-find": "^7.3.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.32",
    "pouchdb-adapter-memory": "^9.0.0",
    "pouchdb-core": "^9.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  }
}
